#!/usr/bin/env bash
# Outputs {"volume": N, "mute": "yes"|"no"} for default sink, follows changes.

emit() {
  v=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -oP '\d+%' | head -1 | tr -d '%')
  m=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')
  echo "{\"volume\": ${v:-0}, \"mute\": \"${m:-no}\"}"
}

emit

pactl subscribe 2>/dev/null \
| grep --line-buffered -E "sink|server" \
| while read -r _; do emit; done
