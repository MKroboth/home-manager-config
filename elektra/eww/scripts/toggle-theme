#!/usr/bin/env sh
# Flips between dark and light mode:
#  - persists state in ~/.cache/eww-theme
#  - updates eww darkMode var so SCSS classes swap live
#  - applies the matching GTK + icon theme via gsettings
#  - kicks off an awww-driven wallpaper re-pick with a fade

STATE_FILE="$HOME/.cache/eww-theme"
mkdir -p "$(dirname "$STATE_FILE")"

current=$(cat "$STATE_FILE" 2>/dev/null || echo dark)
if [ "$current" = "dark" ]; then
    next=light
else
    next=dark
fi

printf '%s' "$next" > "$STATE_FILE"

"$(dirname "$0")/apply-theme" "$next"

"$HOME/bin/wallpapers.sh" "$next" >/dev/null 2>&1 &
