#!/usr/bin/env bash
# Output network status JSON; reacts to netlink link/addr changes via `ip monitor`.

emit() {
  br0_state=$(cat /sys/class/net/br0/operstate 2>/dev/null || echo "down")
  br0_ip=$(ip -j addr show br0 2>/dev/null | jq -r '.[0].addr_info[0].local // "none"' 2>/dev/null)
  wifi_state=$(cat /sys/class/net/wlp15s0/operstate 2>/dev/null || echo "down")
  echo "{\"wired\": \"$br0_state\", \"wired_ip\": \"${br0_ip:-none}\", \"wifi\": \"$wifi_state\"}"
}

emit

stdbuf -oL ip monitor link addr 2>/dev/null | while read -r _; do
  sleep 0.05
  emit
done
